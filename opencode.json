{
    "$schema":  "https://opencode.ai/config.json",
    "mcp":  {
                "shadcn":  {
                               "type":  "local",
                               "command":  [
                                               "npx",
                                               "-y",
                                               "mcp-server-shadcn"
                                           ],
                               "enabled":  true
                           },
                "figma":  {
                              "type":  "local",
                              "command":  [
                                              "npx",
                                              "-y",
                                              "figma-developer-mcp",
                                              "--stdio"
                                          ],
                              "enabled":  true,
                              "environment":  {
                                                  "FIGMA_API_KEY":  "{env:FIGMA_API_KEY}"
                                              },
                              "timeout":  12000
                          },
                "playwright":  {
                                   "type":  "local",
                                   "command":  [
                                                   "npx",
                                                   "-y",
                                                   "@playwright/mcp@latest"
                                               ],
                                   "enabled":  true,
                                   "timeout":  12000
                               }
            }
}